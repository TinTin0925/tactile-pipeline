<Window x:Class="UR3Demo.UI.HandEyeCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hand-Eye Capture / Auto Capture"
        Height="900"
        Width="1180"
        MinHeight="760"
        MinWidth="980">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 输出路径 -->
        <GroupBox Header="Output" Grid.Row="0" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="OutputPathTextBox"
                         Grid.Column="0"
                         Text="D:\UCL\FYP\project\data\handeye\runs\session_test_auto_01" />

                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Browse"
                        Click="BrowseButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- 自动采集配置 -->
        <GroupBox Header="Auto Capture Test" Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <!-- waypoint 文件 -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"
                           Text="Waypoint File"/>

                <TextBox x:Name="WaypointFileTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,0,8,8"
                         Text="E:\research\FYP\5.4\session_06\samples.jsonl"/>

                <Button x:Name="BrowseWaypointButton"
                        Grid.Row="0" Grid.Column="2"
                        Margin="0,0,0,8"
                        Content="Browse"
                        Click="BrowseWaypointButton_Click"/>

                <!-- hand-eye summary -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"
                           Text="HandEye Summary"/>

                <TextBox x:Name="HandEyeSummaryTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,0,8,8"
                         Text="E:\research\FYP\5.4\session_06\handeye_compare\summary.json"/>

                <Button x:Name="BrowseSummaryButton"
                        Grid.Row="1" Grid.Column="2"
                        Margin="0,0,0,8"
                        Content="Browse"
                        Click="BrowseSummaryButton_Click"/>

                <!-- 模式说明 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"
                           Text="Mode"/>

                <TextBlock Grid.Row="2" Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="0,2,0,8"
                           TextWrapping="Wrap"
                           Foreground="#555"
                           Text="V1: 自动标定数据采集。支持读取 samples.jsonl 或新的 plan.json，自动移动、稳定等待、抓拍并保存实际 TCP 位姿。"/>

                <!-- 运行选项 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="MoveHomeBeforeStartCheckBox"
                              Margin="0,0,16,0"
                              IsChecked="True"
                              Content="Move Home Before Start"/>
                    <CheckBox x:Name="MoveHomeAfterFinishCheckBox"
                              Margin="0,0,16,0"
                              IsChecked="False"
                              Content="Move Home After Finish"/>
                    <CheckBox x:Name="StopOnFailureCheckBox"
                              Margin="0,0,16,0"
                              IsChecked="True"
                              Content="Stop On Failure"/>
                    <CheckBox x:Name="EnableVisionHookCheckBox"
                              IsChecked="False"
                              Content="Enable Vision Hook (reserved)"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 中间区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- 相机预览 -->
            <GroupBox Header="Camera Preview" Grid.Column="0" Margin="0,0,12,0">
                <Grid Margin="12">
                    <Border BorderBrush="#DDD" BorderThickness="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- 右侧状态 -->
            <GroupBox Header="Capture Status" Grid.Column="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SessionModeText" Grid.Row="0" Margin="0,0,0,8" Text="Mode: -" />
                    <TextBlock x:Name="SessionRootText" Grid.Row="1" Margin="0,0,0,8" Text="Root: -" />
                    <TextBlock x:Name="SessionJsonlText" Grid.Row="2" Margin="0,0,0,8" Text="JSONL: -" />
                    <TextBlock x:Name="SampleCountText" Grid.Row="3" Margin="0,0,0,8" Text="Next Index: -" />
                    <TextBlock x:Name="CurrentPoseText" Grid.Row="4" Margin="0,0,0,8" Text="Current TCP Pose: -" />
                    <TextBlock x:Name="LastCaptureText" Grid.Row="5" Margin="0,0,0,8" Text="Last Capture: -" />
                    <TextBlock x:Name="AutoCapturePlanText" Grid.Row="6" Margin="0,0,0,8" Text="Plan: -" />
                    <TextBlock x:Name="AutoCaptureStateText" Grid.Row="7" Margin="0,0,0,8" Text="Auto State: Idle" />

                    <TextBox x:Name="InfoTextBox"
                             Grid.Row="8"
                             Margin="0,12,0,0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             Text="Ready."/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CaptureButton"
                    Width="150"
                    Height="36"
                    Margin="0,0,8,0"
                    Content="Capture Sample"
                    Click="CaptureButton_Click"/>

            <Button x:Name="RunAutoCaptureButton"
                    Width="180"
                    Height="36"
                    Margin="0,0,8,0"
                    Content="Run Auto Capture"
                    Click="RunAutoCaptureButton_Click"/>

            <Button x:Name="CloseButtonEx"
                    Width="120"
                    Height="36"
                    Margin="0,0,8,0"
                    Content="Close"
                    Click="CloseButtonEx_Click"/>

            <Button x:Name="CameraSettingsButton"
                    Width="36"
                    Height="36"
                    FontSize="18"
                    Content="⚙"
                    ToolTip="Camera Settings"
                    Click="CameraSettingsButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
