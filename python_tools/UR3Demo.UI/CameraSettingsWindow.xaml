<Window x:Class="UR3Demo.UI.CameraSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Settings"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="相机参数设置"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="当前状态" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="曝光 (ms)"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatusExposureText"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="增益 (dB)"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatusGainText"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="目标帧率 (Hz)"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatusFramerateText"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="实际帧率 (Hz)"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatusMeasuredFpsText"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="自动白平衡"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StatusAutoWbText"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="WB (R, G, B)"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="StatusWbText"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="错误"/>
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="StatusErrorText" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="曝光 / 增益 / 帧率" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="曝光 (ms)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ExposureTextBox" Margin="4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="增益 (dB)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GainTextBox" Margin="4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="帧率 (Hz)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FramerateTextBox" Margin="4"/>

                <Button Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="4,8,4,0"
                        Height="32"
                        Content="应用曝光 / 增益 / 帧率"
                        Click="ApplyImageParams_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="白平衡" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="WB R" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="WbRTextBox" Margin="4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="WB G" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="WbGTextBox" Margin="4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="WB B" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="WbBTextBox" Margin="4"/>

                <UniformGrid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Columns="2" Margin="4,8,4,0">
                    <Button Margin="4" Height="32" Content="开启自动白平衡" Click="EnableAwb_Click"/>
                    <Button Margin="4" Height="32" Content="关闭自动白平衡" Click="DisableAwb_Click"/>
                </UniformGrid>

                <UniformGrid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Columns="2" Margin="4">
                    <Button Margin="4" Height="32" Content="冻结当前自动白平衡" Click="FreezeAwb_Click"/>
                    <Button Margin="4" Height="32" Content="写入手动白平衡" Click="ApplyManualWb_Click"/>
                </UniformGrid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Vertical">
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Margin="4" Height="32" Content="打开本地参数面板" Click="OpenPythonPanel_Click"/>
                <Button Margin="4" Height="32" Content="保存当前全部参数" Click="SaveSettings_Click"/>
            </UniformGrid>

            <UniformGrid Columns="2">
                <Button Margin="4" Height="32" Content="刷新状态" Click="RefreshStatus_Click"/>
                <Button Margin="4" Height="32" Content="关闭" Click="Close_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>